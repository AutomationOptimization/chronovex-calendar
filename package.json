{
  "name": "chronovex-calendar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chronovex — an adaptive, intelligent calendar built for GitHub Pages.",
  "scripts": {
    "dev": "node server.mjs .",
    "build": "node scripts/build.mjs",
    "preview": "node server.mjs _site",
    "test": "node --test",
    "check": "npm run test && npm run build",
    "relay:deploy": "cd relay && npx wrangler deploy",
    "relay:dev": "cd relay && npx wrangler dev"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
